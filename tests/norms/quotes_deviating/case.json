            "norm": "Style/StringLiterals",
            "after": {
              "single_quotes": 0,
              "double_quotes": 1
            },
            "scope": "method",
            "inferred": "single_quotes",
            "direction": "diverging",
            "restyle": false,
            "flagged": false,
            "deviations": [
              {
                "line": 6,
                "column": 9,
                "style": "double_quotes",
                "expected": "single_quotes",
                "edit": "--- a/a.rb\n+++ b/a.rb\n@@ -6,1 +6,1 @@\n-    d = \"four\"\n+    d = 'four'\n"
              }
            ]
          }
        ]
      }
    ]
  }
