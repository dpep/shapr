{
  "description": "shapr norms reports a file's norms with no diff: adherence and each deviation's place",
  "args": [
    "norms",
    "-j",
    "lib/a.rb"
  ],
  "norm": "Style/StringLiterals",
  "expect": {
    "files": [
      {
        "file": "lib/a.rb",
        "language": "ruby",
        "record": "file",
        "skipped": null
      }
    ],
    "norms": [
      {
        "confidence": 0.83,
        "configured": null,
        "counts": {
          "double_quotes": 1,
          "single_quotes": 9
        },
        "deviations": [
          {
            "column": 5,
            "expected": "single_quotes",
            "line": 10,
            "style": "double_quotes",
            "file": "lib/a.rb"
          }
        ],
        "expected": "single_quotes",
        "inferred": "single_quotes",
        "norm": "Style/StringLiterals",
        "record": "norm",
        "scope": "file",
        "adherence": 0.9,
        "matching": 9,
        "judged": 10
      }
    ]
  }
}
