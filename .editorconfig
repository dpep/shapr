root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py}]
indent_size = 4

[Makefile]
indent_style = tab

# Norms fixtures hold deliberate trailing whitespace and missing final
# newlines. `insert_final_newline = false` would strip the rest.
[tests/norms/**]
insert_final_newline = unset
trim_trailing_whitespace = false
